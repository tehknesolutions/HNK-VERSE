{
  "name": "hnk-verse",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm test && pnpm web:build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm test:zero && pnpm test:persistence-schema && pnpm test:web-local && pnpm test:chronicle && pnpm test:spatial && pnpm test:path-routing",
    "test:zero": "node --experimental-strip-types scripts/zero-runtime-check.ts",
    "test:persistence-schema": "node scripts/zero-persistence-schema-check.mjs",
    "web:dev": "pnpm --filter @hnk-verse/web dev",
    "web:build": "pnpm --filter @hnk-verse/web build",
    "test:web-local": "node --experimental-strip-types scripts/zero-web-local-persistence-check.ts",
    "test:chronicle": "node --experimental-strip-types scripts/zero-chronicle-check.ts",
    "test:spatial": "node --experimental-strip-types scripts/zero-spatial-check.ts",
    "test:path-routing": "node --experimental-strip-types scripts/zero-path-routing-check.ts"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "@hnk-verse/chronicle": "workspace:*",
    "@hnk-verse/contracts": "workspace:*",
    "@hnk-verse/domain": "workspace:*",
    "@hnk-verse/fixtures": "workspace:*",
    "@hnk-verse/persistence": "workspace:*",
    "@hnk-verse/renderer": "workspace:*",
    "@hnk-verse/simulation": "workspace:*",
    "@hnk-verse/world": "workspace:*"
  },
  "type": "module"
}
