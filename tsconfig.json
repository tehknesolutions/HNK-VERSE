{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@hnk-verse/contracts": ["packages/contracts/src/index.ts"],
      "@hnk-verse/domain": ["packages/domain/src/index.ts"],
      "@hnk-verse/persistence": ["packages/persistence/src/index.ts"],
      "@hnk-verse/fixtures": ["packages/fixtures/src/index.ts"],
      "@hnk-verse/simulation": ["packages/simulation/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts"]
}
